# HyperNova 개발 환경 버전 고정
#
# compose.yaml, ./docker/hn, .github/workflows/docker-ros.yml이 모두 이 파일을 읽습니다.
# 근거와 버전 표: docs/decisions/0002-dev-environment.md §4
# 개인 설정(UID, ROS_DOMAIN_ID, 데이터 폴더)은 여기가 아니라 docker/.env.local에 둡니다.
# bash에서 source해도 되도록 KEY=value(공백·따옴표 없이) 형식을 지킵니다.

# --- 이미지 이름과 태그 ---
# Dockerfile, docker/scripts, docker/ros, pyproject.toml/uv.lock, 아래 버전이 바뀌는 PR에서는 태그를 올립니다.
# main에 병합되면 CI가 ros 이미지를 GHCR에 이 태그로 올립니다. sim은 각자 로컬에서 빌드합니다.
HN_IMAGE_TAG=2026.10.1
HN_ROS_IMAGE=ghcr.io/hypernova26/hn:ros-${HN_IMAGE_TAG}
HN_SIM_IMAGE=hn:sim-${HN_IMAGE_TAG}

# --- 베이스 이미지 (태그 + 다이제스트로 고정) ---
# 2026-10-22 확인. 올릴 때는 새 태그의 다이제스트를 함께 바꿉니다.
#   docker buildx imagetools inspect <이미지:태그>   # 맨 위 Digest 값
ROS_BASE_IMAGE=ros:jazzy-ros-base@sha256:103b6c417973394659af6804d4917cd489b91e5ed22eb7bef263025a3bed2410
ISAACLAB_BASE_IMAGE=nvcr.io/nvidia/isaac-lab:3.0.0@sha256:f70acc9ed3bc3fc67099a0c5715379c432cc9965623cabbaf54f74599997e245

# --- ROS 2 apt ---
# snapshots.ros.org/<배포판>/<날짜>/ubuntu 를 쓰므로 같은 날짜면 언제 빌드해도 같은 ROS 패키지가 설치됩니다.
ROS_DISTRO=jazzy
ROS_SNAPSHOT_DATE=2026-10-05

# --- uv (robot venv 설치용) ---
# https://github.com/astral-sh/uv/releases/download/<버전>/uv-<arch>-unknown-linux-gnu.tar.gz 의 sha256
UV_VERSION=0.13.5
UV_SHA256_AMD64=f68d291c75783122dad58ab77def0e13f3233f358731db5d6d7e8715603b928f
UV_SHA256_ARM64=4bb69cf95ed13f23713bb7bc09f241896ea0c75b7c557e615a20604b82f9c403
