      "2\u00b73\ubc88 \ubc84\uc2a4\ub294 '\ub9e8 \uc67c\ucabd \uacbd\uc0ac\ub85c \uc544\ub798'\ub77c\ub294 \uc124\uba85\uae4c\uc9c0 \ub300\uc870\ud588\uc9c0\ub9cc \uc6d0\ubcf8\uc758 \ud2b9\uc815 \ucc28\uccb4\ub85c \ud655\uc815\ud558\uc9c0 \ubabb\ud588\ub2e4. \ubc84\uc2a4 \uc81c\uac70 \uc644\ub8cc\ub85c \ud45c\uc2dc\ud558\uc9c0 \uc54a\ub294\ub2e4. 5\u00b76\ubc88\ub3c4 \ud654\uba74 \uc88c\ud45c\uc640 \uc815\ud655\ud55c \uc815\ud569\uc740 \uc5c6\uc73c\uba70 \uc0c1\ubd80 \ub3c4\ub85c\uc758 \uc2e4\uce21 \uc5f0\uc18d\uc131\uc744 \uadfc\uac70\ub85c \uc218\uc815\ud588\ub2e4.",
      "\ucc28\ub7c9 \uc218\ub3d9 \uac80\ud1a0\ub294 \uae30\uc874 \ud45c\uc2dc \ubc16 26\uac1c \ubc94\uc704\ub97c \ucd94\uac00\ud588\ub2e4. \ubc00\uc9d1\ud55c \ub450 \uc8fc\ucc28\uc5f4\uc758 \uc704\u00b7\uc606 \ub2e8\uba74\uc744 \ud655\uc778\ud588\uc9c0\ub9cc \ub098\uba38\uc9c0 \uc8fc\ucc28\uc7a5\uc758 \ubaa8\ub4e0 \ucc28\ub7c9\uc744 \ube60\uc9d0\uc5c6\uc774 \uac80\ud1a0\ud588\ub2e4\ub294 \ub73b\uc740 \uc544\ub2c8\ub2e4.",
      "\uc9c1\uc0ac\uac01\ud615 \uac80\uc0c9\ub760 \uc804\uccb4\ub97c \uc81c\uc678\ud558\ub358 \ucc98\ub9ac\ub9cc \ud574\uc81c\ud588\ub2e4. \uae30\uc874 \uad6d\uc18c \uc2dd\uc7ac\u00b7\uae30\ub465 \uc81c\uc678 \ub9c8\uc2a4\ud06c\ub294 \uc720\uc9c0\ud558\uba70, \uc774 \ub9c8\uc2a4\ud06c\ub3c4 \uc644\uc804\ud55c \uc758\ubbf8 \ubd84\ub958 \uc815\ub2f5\uc740 \uc544\ub2c8\ub2e4.",
      "\ucc28\ub7c9 \uc544\ub798 \ubcf4\uac04\uc740 \uc8fc\ubcc0 \uc2e4\uce21\uc810\uc5d0 \uadfc\uac70\ud55c \ucd94\uc815\uc774\ub2e4. \ubbf8\uad00\uce21 \uc815\ub2f5 \ub192\uc774\uc640 \ube44\uad50\ud55c \uacb0\uacfc\uac00 \uc544\ub2c8\uba70 \uc9c0\uc9c0\uc810 \ubd80\uc871\u00b7\ub2e8\ucc28\u00b7\uc81c\uc678 \uacbd\uacc4\uc5d0\uc11c\ub294 \ube48\uce78\uc774 \ub0a8\ub294\ub2e4.",
      "\uc774\uc911 \uc9c0\uba74\uacfc \uc794\uc5ec \uc624\ubd84\ub958, \uc6d0\ubcf8 \ud76c\uc18c \uad6c\uac04\uc740 \ub0a8\uc544 \uc788\ub2e4. \uc774 \ud30c\uc77c\uc740 \ucd5c\uc885 \ubcf4\ud589 \uac00\ub2a5 \uc9c0\ub3c4\ub098 \uc644\uc131\ub41c \ubb3c\ub9ac \uc9c0\ud615\uc774 \uc544\ub2c8\ub2e4."
